{#- Backtick-escape class names that Mermaid would not read as one plain identifier -#}
{%- macro mc(n) -%}{{ n if (n | replace('_', '')).isalnum() and not n[:1].isdigit() else '`' ~ n ~ '`' }}{%- endmacro -%}
{% macro slot_relationship(element, slot) %}
    {% if slot.range is not none %}
        {% set range_element = gen.name(schemaview.get_element(slot.range)) %}
        {% set relation_label = gen.name(slot) %}
        {{ mc(gen.name(element)) }} --> "{{ gen.cardinality(slot) }}" {{ mc(range_element) }} : {{ relation_label }}
        click {{ mc(range_element) }} href "{{ gen.link_mermaid(schemaview.get_element(slot.range)) }}"
    {% endif %}
{% endmacro %}

{% if schemaview.class_parents(element.name) and schemaview.class_children(element.name) %}
```{{ gen.mermaid_directive() }}
 classDiagram
    class {{ mc(gen.name(element)) }}
    click {{ mc(gen.name(element)) }} href "{{ gen.link_mermaid(element) }}"
      {% for s in schemaview.class_parents(element.name)|sort(attribute='name') -%}
        {{ mc(gen.name(schemaview.get_element(s))) }} <|-- {{ mc(gen.name(element)) }}
        click {{ mc(gen.name(schemaview.get_element(s))) }} href "{{ gen.link_mermaid(schemaview.get_element(s)) }}"
      {% endfor %}

      {% for s in schemaview.class_children(element.name)|sort(attribute='name') -%}
        {{ mc(gen.name(element)) }} <|-- {{ mc(gen.name(schemaview.get_element(s))) }}
        click {{ mc(gen.name(schemaview.get_element(s))) }} href "{{ gen.link_mermaid(schemaview.get_element(s)) }}"
      {% endfor %}

      {% for s in schemaview.class_induced_slots(element.name)|sort(attribute='name') -%}
        {{ mc(gen.name(element)) }} : {{ gen.name(s) }}
        {% if s.range is not none and s.range not in gen.all_type_object_names() %}
          {{ slot_relationship(element, s) }}
        {% endif %}
      {% endfor %}
```
