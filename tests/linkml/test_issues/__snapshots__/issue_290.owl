@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ex: <http://example.org/> .
ex:C a owl:Class , linkml:ClassDefinition ;
	rdfs:label "c" ;
	skos:inScheme <http://example.org> .
ex:s a owl:ObjectProperty , owl:SymmetricProperty , linkml:SlotDefinition ;
	rdfs:label "s" ;
	rdfs:range ex:C ;
	owl:inverseOf ex:t ;
	skos:inScheme <http://example.org> .
ex:t a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "t" ;
	rdfs:range ex:C ;
	skos:inScheme <http://example.org> .
<http://example.org> a owl:Ontology ;
	rdfs:label "example.org" .
skos:inScheme a owl:AnnotationProperty .
