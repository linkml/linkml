@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <https://w3id.org/linkml/examples/test/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix linkml: <https://w3id.org/linkml/> .
xsd:string a rdfs:Datatype .
skos:inScheme a owl:AnnotationProperty .
ex:C1 a owl:Class ;
	rdfs:label "C1" ;
	rdfs:subClassOf _:c14n0 , _:c14n1 , _:c14n2 ;
	skos:inScheme linkml:examples\/test .
ex:a a owl:DatatypeProperty ;
	rdfs:label "a" ;
	skos:inScheme linkml:examples\/test .
linkml:examples\/test a owl:Ontology ;
	rdfs:label "test" .
_:c14n0 a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty ex:a .
_:c14n1 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty ex:a .
_:c14n2 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:a .
